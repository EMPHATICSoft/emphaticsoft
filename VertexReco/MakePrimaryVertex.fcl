BEGIN_PROLOG

standard_makeprimaryvertex:
{
  module_type: MakePrimaryVertex
  TrkLabel:       "makesingletracks" 
  BeamTrkLabel:   "beamtrackreco"
}

# --- For Kalman tracks ---
kalman_makeprimaryvertex: @local::standard_makeprimaryvertex
kalman_makeprimaryvertex.TrkLabel: "singletrackKalman"

END_PROLOG
