BEGIN_PROLOG

standard_arichreco:
{
  module_type: 	  ARICHReco
  PD_file:        "/ARICHReco/PMTDet.root"
  LabelHits:      "arichcluster"
  LabelTracks:     "makesingletracks"
  FillTree:       true

  #WHICH PID TO RUN
  UseLL: 	 true
  UseML:	 true
 
  #ARICH SHIFTS FOR LL CALCULATIONS [mm]
  ArichXshift:	15
  ArichYshift:  -6

  #TORCH MODEL
  ModelPath: 	   "/TorchML/arich_model.pt"


  # PARAMS OF ARICH, AEROGELS
  PD_Darkrate: 406 				#Hz
  Trigger_window: 5				#ns
  PD_FillFactor: 1			
}

END_PROLOG
