BEGIN_PROLOG

standard_arich_ring:
{
  module_type: 	  MakeRing
  LabelHits:      "arichcluster"
  LabelTracks:    "makesingletracks"   
  FillTree:       true
  SeedWithTrack:  true                 

  RFitMin:        10.0    # mm 
  RMatchTol:      3.0     # mm 
  RFitHalfWidth:  3.0     # mm
  HoughMinVoteFraction: 0.5
}

END_PROLOG
