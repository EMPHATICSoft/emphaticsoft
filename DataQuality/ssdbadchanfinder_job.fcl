#include "Services.fcl"
#include "SSDBadChannelFinder.fcl"
#include "SSDBadChannel.fcl"

process_name: SSDBadChan

source: 
{
  module_type: RootInput
  maxEvents: -1
}

services: 
{
  @table::standard_services
  TFileService: { fileName: "ssdbadchan_r%r_s%04s.root"}
  SSDBadChannelService: @local::standard_ssdbadchannel
}

physics:
{
  analyzers: 
  {
    badchan: @local::standard_ssdbadchannelfinder
  }

  ana: [ badchan  ]
  end_paths: [ ana ]
}
