# ---- generation ----
#include "Services.fcl"
#include "Geometry.fcl"
#include "MagneticField.fcl"
#include "RunHistory.fcl"
#include "BeamGen.fcl"
#include "G4Gen.fcl"

#include "SSDDigitizer.fcl"
#include "ARICHDigitizer.fcl"
#include "RelabelRawDigitModules.fcl"
#include "SSDEfficiency.fcl"

#include "MakeArichCluster.fcl"
#include "GetDataML.fcl"

process_name: GetDataML

services:
{ 
  @table::sim_services
  
  TFileService:          { fileName: "mc_g4_to_caf_hist_pions.root" closeFileFast: false }
  scheduler:             { wantSummary: false }
  TimeTracker:           {}
  
  # needed by Geant4 generation
  RandomNumberGenerator: {}
  MagneticFieldService:  @local::standard_magfield
  RunHistoryService:     @local::standard_runhistory
  SSDEfficiencyService: @local::data_ssdefficiency
  IFBeam:                {}
}

services.AlignService.IsDisabled: true

source:
{
  module_type: EmptyEvent
  maxEvents:   1000        # override with -n on the command line / grid
  firstRun:    2408
  firstSubRun: 1
}


outputs:
{
 out1:
  {
   module_type: RootOutput
   fileName: 	"%ifb.dataML.root" 
   fastCloning: false
   
  }
}

# Define and configure some modules to do work on each event.
# First modules are defined; they are scheduled later.
# Modules are grouped by type.
physics:
{
  producers:

   {	

    generator:    @local::proton_sliced
    geantgen:     @local::standard_geant4


    rawSSD:        @local::standard_ssddigitizer
    rawARICH:      @local::standard_arichdigitizer
    raw:           @local::standard_digitrelabel	
 
    arichcluster: @local::standard_arich_cluster 
   }


  analyzers:
 {
	getdata: @local::standard_getdataML
 }	

  prods: [generator, geantgen, rawSSD, rawARICH, raw, arichcluster ]

  trigger_paths: [ prods]
 
  e1: [getdata]	
  filters:{}
  end_paths: [e1]

  stream1: [ out1 ]

}

physics.producers.generator.UseRunHistory: false
physics.producers.generator.particleType: "mix"
physics.producers.generator.pzDist: "flat"
physics.producers.generator.PMean: 6
physics.producers.generator.Psigma: 4

physics.producers.rawARICH.IncludeNoise: false
physics.analyzers.getdata.TorchFile: "arich_training_nonoise.pt"

